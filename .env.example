# ═══════════════════════════════════════════════════
# CHAVES DE API — preencha pelo menos 2 para garantir fallback
# ═══════════════════════════════════════════════════

# Google Gemini (1.500 req/dia grátis) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq Cloud (14.400 req/dia grátis, ultrarrápido) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (modelos :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Alibaba DashScope (1M tokens grátis) — https://dashscope-intl.aliyuncs.com
DASHSCOPE_API_KEY=

# Zhipu AI (GLM Flash grátis) — https://open.bigmodel.cn
ZHIPU_API_KEY=

# SiliconFlow (modelos $0 permanente) — https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# HuggingFace ($0.10/mês créditos) — https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# CometAPI (créditos de cadastro) — https://cometapi.com
COMETAPI_KEY=

# Nexa API ($5 trial) — https://rapidapi.com/user/nexaquency
NEXA_API_KEY=

# ═══════════════════════════════════════════════════
# INTEGRAÇÕES ADICIONAIS (OPCIONAL)
# ═══════════════════════════════════════════════════

# ElevenLabs (Síntese de voz TTS realista para narração)
ELEVENLABS_API_KEY=

# Replicate API (Geração de avatar e vídeo)
REPLICATE_API_TOKEN=

# URL da aplicação
APP_URL=
